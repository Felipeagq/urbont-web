# ─────────────────────────────────────────────────────────────────────────────
# URBONT WEBSITE v2 — variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local para desarrollo.
# En AWS Amplify: App settings → Environment variables.
#
# Todas son SOLO DE SERVIDOR (sin prefijo NEXT_PUBLIC_): las leen los route
# handlers de src/app/api/, nunca llegan al bundle del navegador.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorio — misma base que la app móvil) ─────────────────────
# Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# ── Secreto de firma de JWT (OBLIGATORIO) ────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# A diferencia del proyecto original, NO hay valor por defecto. Si falta, la app
# falla al arrancar en lugar de firmar tokens con un secreto público del repo.
JWT_SECRET=

# ── Twilio SMS (obligatorio en producción para el OTP) ───────────────────────
# Sin estas variables:
#   - en desarrollo: el código OTP se devuelve en la respuesta (campo devCode)
#   - en producción: /api/otp/send responde 503
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# ── Supabase de navegador (login con Google) ─────────────────────────────────
# La anon key es pública por diseño: viaja en el bundle y sólo concede lo que
# permitan las políticas RLS. Sin estas dos, el botón de Google no funciona.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
